# =============================================================
# AOUN PROJECT — ENVIRONMENT VARIABLES TEMPLATE
# =============================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.
# =============================================================

# ----- SERVER-ONLY (Never exposed to the browser) -----

# URL of the .NET backend API — server-side only (no NEXT_PUBLIC prefix)
API_URL=https://aoun-api.runasp.net

# URL of the AI/Python backend service — server-side only
AI_API_URL=https://muhammadmahmoud-awn-ai-service.hf.space

# JWT secret for verifying tokens — MUST be at least 32 characters
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_string_m in_32_chars

# ----- NODE ENVIRONMENT -----
# Values: development | test | production
NODE_ENV=development

# ----- OPTIONAL -----
# Set to "true" to allow HTTP cookies in local development (non-HTTPS)
# ALLOW_INSECURE_COOKIES=true
